<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-to-device transfer rules for Android 12+ (android:dataExtractionRules).
    Same content as backup_rules.xml: the saved game, statistics and settings in the WebView's
    localStorage travel with the user, WebView caches do not.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/Default/Local Storage" />
        <include domain="root" path="app_webview/Local Storage" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/Default/Local Storage" />
        <include domain="root" path="app_webview/Local Storage" />
    </device-transfer>
</data-extraction-rules>
